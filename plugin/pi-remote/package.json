{
  "name": "@liuscraft/pi-remote",
  "version": "0.1.0",
  "description": "Serve pi sessions to a remote Pi Desktop: run /remote start in a plain pi, then connect from Pi Desktop on another machine.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/LiusCraft/pi-desktop/tree/main/plugin/pi-remote",
  "bugs": {
    "url": "https://github.com/LiusCraft/pi-desktop/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiusCraft/pi-desktop.git",
    "directory": "plugin/pi-remote"
  },
  "files": [
    "index.js",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  }
}
