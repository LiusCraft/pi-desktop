{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortTailwindcss": {
    "stylesheet": "./src/renderer/src/styles/globals.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    "package-lock.json",
    "docs/**",
    "demo/**",
    "README.md",
    ".agents/**",
    ".github/**",
    "out/**",
    "dist/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
