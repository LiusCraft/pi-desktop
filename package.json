{
  "name": "pi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-desktop style agent app built on the pi coding agent SDK",
  "author": "LiusCraft",
  "license": "MIT",
  "homepage": "https://github.com/liuscraft/pi-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuscraft/pi-desktop.git"
  },
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "demo": "electron-vite preview -- --demo",
    "build": "npm run build:plugin && electron-vite build",
    "build:plugin": "vite build -c plugin/vite.config.mts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "npm run build && playwright test --config=playwright.config.ts",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "publish:mac": "npm run build && electron-builder --mac dmg --publish always",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "publish:win": "npm run build && electron-builder --win nsis --publish always",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "node-pty": "^1.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@pierre/diffs": "^1.6.2",
    "@pierre/trees": "^1.0.0-beta.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "immer": "^11.2.9",
    "lucide-react": "^1.61.0",
    "mermaid": "^11.17.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
